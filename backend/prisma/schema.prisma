// FitPath data model — every entity named in the product spec (section 30).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile       UserProfile?
  goals         Goal[]
  plans         TrainingPlan[]
  sessions      WorkoutSession[]
  progress      ProgressRecord[]
  schedules     DailySchedule[]
  conversations AIConversation[]
  subscription  Subscription?
}

model UserProfile {
  id                String   @id @default(cuid())
  user              User     @relation(fields: [userId], references: [id])
  userId            String   @unique

  name              String
  age               Int
  heightCm          Float?
  weightKg          Float?
  gender            String?

  sport             String   // free text, e.g. "Basketball"
  experienceLevel   String   // beginner | intermediate | advanced
  trainingHistory   String   // never | <3mo | 3-6mo | 6-12mo | 1-2y | 2y+
  difficulty        String   // easy | moderate | hard | very_hard

  daysPerWeek       Int
  sessionMinutes    Int
  location          String   // home | gym | outdoor | facility | multiple
  equipment         String[] // e.g. ["dumbbells","jump_rope"]

  transformationLength String // "1_month" | "3_months" | ... | "custom"
  customLengthWeeks    Int?

  wakeTime          String?  // "08:00"
  sleepTime         String?  // "23:00"
  busyBlocks        Json?    // [{label:"School", start:"09:00", end:"14:00"}]

  updatedAt         DateTime @updatedAt
}

model SportGoal {
  id        String  @id @default(cuid())
  userId    String
  sport     String
  label     String   // "Shooting", "Speed", ... or custom free text
  custom    Boolean  @default(false)
}

model Exercise {
  id            String   @id @default(cuid())
  name          String
  sport         String
  category      String
  difficulty    String
  instructions  String
  sets          Int?
  reps          Int?
  durationSec   Int?
  restSec       Int?
  equipment     String[]
  purpose       String
  videoUrl      String?
}

model TrainingPlan {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  sport         String
  startDate     DateTime @default(now())
  totalWeeks    Int
  status        String   @default("active") // active | completed | archived
  createdAt     DateTime @default(now())

  phases        TrainingPhase[]
}

model TrainingPhase {
  id            String   @id @default(cuid())
  plan          TrainingPlan @relation(fields: [planId], references: [id])
  planId        String
  monthIndex    Int
  name          String   // "Foundation", "Development", ...
  focus         String
  weeks         TrainingWeek[]
}

model TrainingWeek {
  id            String   @id @default(cuid())
  phase         TrainingPhase @relation(fields: [phaseId], references: [id])
  phaseId       String
  weekIndex     Int
  days          TrainingDay[]
}

model TrainingDay {
  id            String   @id @default(cuid())
  week          TrainingWeek @relation(fields: [weekId], references: [id])
  weekId        String
  dayIndex      Int      // 0=Mon ... 6=Sun
  type          String   // "training" | "rest" | "recovery"
  title         String
  durationMin   Int
  difficulty    String
  blocksJson    Json     // ordered exercise blocks for the day

  sessions      WorkoutSession[]
}

model WorkoutSession {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  day           TrainingDay? @relation(fields: [dayId], references: [id])
  dayId         String?

  startedAt     DateTime @default(now())
  completedAt   DateTime?
  durationSec   Int?
  status        String   @default("in_progress") // in_progress | completed | skipped
  perceivedDifficulty String?
  formScore     Int?     // overall AI Form Coach score 0-100 (null if the camera wasn't used)
  notes         String?

  exercises     WorkoutExercise[]
}

model WorkoutExercise {
  id            String   @id @default(cuid())
  session       WorkoutSession @relation(fields: [sessionId], references: [id])
  sessionId     String
  name          String
  setsCompleted Int      @default(0)
  setsTarget    Int?
  repsCompleted Int?
  repsTarget    Int?
  heldSec       Int?     // seconds held (plank) as counted by the AI camera
  formScore     Int?     // AI Form Coach score 0-100 for this exercise
  notes         String?
}

model PerformanceRecord {
  id        String   @id @default(cuid())
  userId    String
  sport     String
  metric    String   // "free_throw_pct", "sprint_40y", "distance_km", ...
  value     Float
  unit      String?
  recordedAt DateTime @default(now())
}

model Goal {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  label       String
  metric      String?
  targetValue Float?
  currentValue Float?
  targetDate  DateTime?
  status      String   @default("active") // active | achieved | abandoned
  createdAt   DateTime @default(now())
}

model DailySchedule {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  date      DateTime
  eventsJson Json    // [{time:"08:00", label:"Wake Up"}, ...]
}

model ProgressRecord {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  date      DateTime @default(now())
  metric    String   // "consistency" | "streak" | "goal_progress" | custom
  value     Float
}

model Subscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  plan      String   @default("free") // free | pro
  status    String   @default("active")
  renewsAt  DateTime?
}

model AIConversation {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  role      String   // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())
}
